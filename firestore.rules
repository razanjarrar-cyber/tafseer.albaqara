rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // only the admin account can read or change the stored GitHub key
    match /admin/{doc} {
      allow read, write: if request.auth != null
        && request.auth.token.email == 'admin@tafseer-albaqara.app';
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
