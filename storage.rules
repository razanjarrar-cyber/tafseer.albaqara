rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /audio/{file} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email in ['YOUR_EMAIL@gmail.com']
                   && request.resource.size < 200 * 1024 * 1024;
    }
  }
}
